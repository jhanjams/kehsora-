{%- comment -%}
  Card for a concentrate whose product isn't available on the Online Store
  yet (or doesn't exist): its photo, name and a link to its ingredient story.
  Disappears by itself once the real product is live.
  Usage: {% render 'concentrate-card', name: 'Peppermint' %}
{%- endcomment -%}
{%- liquid
  assign cc_name = name | strip
  assign cc_handle = cc_name | handle
  capture cc_photo
    render 'product-photo', title: cc_name
  endcapture
  assign cc_photo = cc_photo | strip
  assign cc_cut = false
  if cc_photo == blank
    assign cc_photo = 'bottle-' | append: cc_handle | append: '.png'
    assign cc_cut = true
  endif
  capture cc_kicker
    render 'concentrate-kicker', name: cc_name
  endcapture
  assign cc_kicker = cc_kicker | strip
  assign cc_link = '/pages/ingredients#' | append: cc_handle
-%}
<article class="product-card is-preview" data-handle-card="{{ cc_handle }}-preview">
  <a href="{% render 'safe-url', url: cc_link %}" class="product-card-media{% if cc_cut %} is-cutout{% endif %}" tabindex="-1" aria-hidden="true">
    <img src="{{ cc_photo | asset_url }}" alt="{{ cc_name | escape }}" loading="lazy" width="1295" height="1215">
  </a>
  <div class="product-card-body">
    <div class="product-card-kicker">{{ cc_kicker | upcase | escape }}</div>
    <h3><a href="{% render 'safe-url', url: cc_link %}">{{ cc_name | escape }} Hair Oil Concentrate</a></h3>
    <a href="{% render 'safe-url', url: cc_link %}" class="btn btn-ghost-gold btn-sm btn-block">Discover {{ cc_name | escape }}</a>
  </div>
</article>
