{%- comment -%}
  Heading with an optional italic gold phrase, e.g. "Shop by <em>concern</em>".
  Usage: {% render 'heading', tag: 'h2', text: section.settings.heading, emphasis: section.settings.heading_emphasis, class: '' %}
{%- endcomment -%}
{%- liquid
  assign heading_tag = tag | default: 'h2'
  comment
    Normalise spacing: editors sometimes add a trailing (non-breaking) space to
    the first part. Strip it and always join the two parts with one space.
  endcomment
  assign text_clean = text | replace: ' ', ' ' | strip
  assign emphasis_clean = emphasis | replace: ' ', ' ' | strip
-%}
{%- if text_clean != blank or emphasis_clean != blank -%}
  <{{ heading_tag }}{% if class != blank %} class="{{ class }}"{% endif %}>
    {{- text_clean | escape -}}
    {%- if text_clean != blank and emphasis_clean != blank -%}{{ ' ' }}{%- endif -%}
    {%- if emphasis_clean != blank %}<em>{{ emphasis_clean | escape }}</em>{% endif -%}
  </{{ heading_tag }}>
{%- endif -%}
