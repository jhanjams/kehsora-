<section class="page-hero" style="padding-bottom: 2rem;">
  <div class="container">
    <div class="section-eyebrow center">{{ 'customer.account.eyebrow' | t }}</div>
    {%- assign greet_name = customer.first_name | default: customer.email -%}
    <h1>{{ 'customer.account.hello' | t: name: greet_name }}</h1>
  </div>
</section>
<section class="section" style="padding-top: 1rem;">
  <div class="container">
    <div class="split" style="align-items: start;">
      <div>
        <div class="section-eyebrow">{{ 'customer.account.orders' | t }}</div>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size > 0 -%}
            <table class="orders-table">
              <thead><tr><th>{{ 'customer.orders.order' | t }}</th><th>{{ 'customer.orders.date' | t }}</th><th>{{ 'customer.orders.status' | t }}</th><th>{{ 'customer.orders.total' | t }}</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | time_tag: format: 'date' }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_net_amount | money_with_currency }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          {%- else -%}
            <p>{{ 'customer.orders.none' | t }}</p>
          {%- endif -%}
          {%- if paginate.pages > 1 -%}{{ paginate | default_pagination }}{%- endif -%}
        {%- endpaginate -%}
      </div>
      <div>
        <div class="section-eyebrow">{{ 'customer.account.details' | t }}</div>
        {%- if customer.default_address -%}
          <div class="rte">{{ customer.default_address | format_address }}</div>
        {%- endif -%}
        <div class="account-links" style="justify-content: flex-start; gap: 2rem;">
          <a href="{{ routes.account_addresses_url }}">{{ 'customer.account.addresses' | t: count: customer.addresses_count }}</a>
          <a href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
        </div>
      </div>
    </div>
  </div>
</section>
