<section class="page-hero" style="padding-bottom: 2rem;">
  <div class="container">
    <div class="section-eyebrow center"><a href="{{ routes.account_url }}">{{ 'customer.account.back' | t }}</a></div>
    <h1>{{ 'customer.order.title' | t: name: order.name }}</h1>
    <p>{{ order.created_at | time_tag: format: 'date_at_time' }}</p>
  </div>
</section>
<section class="section" style="padding-top: 1rem;">
  <div class="container">
    {%- if order.cancelled -%}
      <p class="form-message">{{ 'customer.order.cancelled' | t: date: order.cancelled_at }}</p>
    {%- endif -%}
    <table class="orders-table">
      <thead><tr><th>{{ 'customer.order.product' | t }}</th><th>{{ 'customer.order.quantity' | t }}</th><th>{{ 'customer.orders.total' | t }}</th></tr></thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>{{ line_item.title | link_to: line_item.product.url }}{% if line_item.fulfillment %}<br><span class="fine">{{ line_item.fulfillment.created_at | time_tag: format: 'date' }}{% if line_item.fulfillment.tracking_url %} &middot; <a href="{{ line_item.fulfillment.tracking_url }}">{{ 'customer.order.track' | t }}</a>{% endif %}</span>{% endif %}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
    <div class="summary-card" style="position: static; margin-top: 2rem; max-width: 26rem; margin-left: auto;">
      <div class="summary-row"><span>{{ 'cart.subtotal' | t }}</span><span>{{ order.line_items_subtotal_price | money }}</span></div>
      {%- for shipping_method in order.shipping_methods -%}
        <div class="summary-row"><span>{{ shipping_method.title }}</span><span>{{ shipping_method.price | money }}</span></div>
      {%- endfor -%}
      {%- for tax_line in order.tax_lines -%}
        <div class="summary-row"><span>{{ tax_line.title }}</span><span>{{ tax_line.price | money }}</span></div>
      {%- endfor -%}
      <div class="summary-row total"><span>{{ 'cart.total' | t }}</span><span>{{ order.total_net_amount | money_with_currency }}</span></div>
    </div>
    <div class="split" style="margin-top: 3rem; align-items: start;">
      <div><div class="section-eyebrow">{{ 'customer.order.billing' | t }}</div><div class="rte">{{ order.billing_address | format_address }}</div></div>
      <div><div class="section-eyebrow">{{ 'customer.order.shipping' | t }}</div><div class="rte">{{ order.shipping_address | format_address }}</div></div>
    </div>
  </div>
</section>
