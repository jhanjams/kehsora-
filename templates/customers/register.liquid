<section class="page-hero" style="padding-bottom: 2rem;">
  <div class="container">
    <div class="section-eyebrow center">{{ 'customer.account.eyebrow' | t }}</div>
    <h1>{{ 'customer.register.title' | t }}</h1>
  </div>
</section>
<section class="section" style="padding-top: 1rem;">
  <div class="container account-wrap">
    {%- form 'create_customer', class: 'stack' -%}
      {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <input class="field" type="text" name="customer[first_name]" placeholder="{{ 'customer.fields.first_name' | t }}" aria-label="{{ 'customer.fields.first_name' | t }}" autocomplete="given-name">
      <input class="field" type="text" name="customer[last_name]" placeholder="{{ 'customer.fields.last_name' | t }}" aria-label="{{ 'customer.fields.last_name' | t }}" autocomplete="family-name">
      <input class="field" type="email" name="customer[email]" placeholder="{{ 'customer.fields.email' | t }}" aria-label="{{ 'customer.fields.email' | t }}" autocomplete="email" required>
      <input class="field" type="password" name="customer[password]" placeholder="{{ 'customer.fields.password' | t }}" aria-label="{{ 'customer.fields.password' | t }}" autocomplete="new-password" required>
      <label class="checkbox-row"><input type="checkbox" name="customer[accepts_marketing]" value="true"> {{ 'customer.register.marketing' | t }}</label>
      <button type="submit" class="btn btn-gold">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}
    <div class="account-links"><a href="{{ routes.account_login_url }}">{{ 'customer.register.have_account' | t }}</a></div>
  </div>
</section>
