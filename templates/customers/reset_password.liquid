<section class="page-hero" style="padding-bottom: 2rem;">
  <div class="container"><h1>{{ 'customer.reset.title' | t }}</h1><p>{{ 'customer.reset.subtext' | t }}</p></div>
</section>
<section class="section" style="padding-top: 1rem;">
  <div class="container account-wrap">
    {%- form 'reset_customer_password', class: 'stack' -%}
      {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <input class="field" type="password" name="customer[password]" placeholder="{{ 'customer.fields.password' | t }}" aria-label="{{ 'customer.fields.password' | t }}" autocomplete="new-password" required>
      <input class="field" type="password" name="customer[password_confirmation]" placeholder="{{ 'customer.fields.password_confirm' | t }}" aria-label="{{ 'customer.fields.password_confirm' | t }}" autocomplete="new-password" required>
      <button type="submit" class="btn btn-gold">{{ 'customer.reset.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
