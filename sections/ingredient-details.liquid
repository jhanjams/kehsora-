<section class="section" style="padding-top: 1rem;">
  <div class="container">
    {%- for block in section.blocks -%}
      {%- liquid
        assign ing_product = block.settings.product
        if ing_product == blank or ing_product.id == blank
          capture ph
            render 'product-handle', name: block.settings.name
          endcapture
          assign ph = ph | strip
          if ph != blank
            assign ing_product = all_products[ph]
          endif
        endif
        assign ing_image = block.settings.image | default: ing_product.featured_image
        assign ing_name = block.settings.name | default: ing_product.title
        assign ing_anchor = block.settings.anchor | default: ing_name | handle
        assign chips = block.settings.benefits | split: ','
      -%}
      <div class="ingredient-detail{% cycle '', ' reverse' %}" id="{{ ing_anchor }}" {{ block.shopify_attributes }}>
        <div class="ingredient-media reveal">
          {%- if block.settings.number != blank -%}<span class="big-index" aria-hidden="true">{{ block.settings.number | escape }}</span>{%- endif -%}
          <div class="arch-frame">
            {%- if ing_image != blank -%}
              {{ ing_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '440, 660, 900', sizes: '(min-width: 860px) 440px, 90vw', alt: ing_name }}
            {%- else -%}
              {{ 'product-3' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
        <div class="reveal">
          <div class="ingredient-detail-num">
            {%- if block.settings.number != blank -%}{{ block.settings.number | escape }} &mdash; {% endif -%}
            {{- block.settings.kicker | upcase | escape -}}
          </div>
          <h2>{{ ing_name | escape }}</h2>
          <div class="rte">{{ block.settings.text }}</div>
          {%- if block.settings.benefits != blank -%}
            <div class="ingredient-benefits">
              {%- for chip in chips -%}<span class="ingredient-benefit-chip">{{ chip | strip | escape }}</span>{%- endfor -%}
            </div>
          {%- endif -%}
          {%- capture facts -%}
            {%- if block.settings.botanical != blank -%}<div class="ing-fact"><dt>Botanical name</dt><dd><em>{{ block.settings.botanical | escape }}</em></dd></div>{%- endif -%}
            {%- if block.settings.origin != blank -%}<div class="ing-fact"><dt>Origin</dt><dd>{{ block.settings.origin | escape }}</dd></div>{%- endif -%}
            {%- if block.settings.compounds != blank -%}<div class="ing-fact"><dt>Key compounds</dt><dd>{{ block.settings.compounds | escape }}</dd></div>{%- endif -%}
            {%- if block.settings.preparation != blank -%}<div class="ing-fact"><dt>How we prepare it</dt><dd>{{ block.settings.preparation | escape }}</dd></div>{%- endif -%}
            {%- if block.settings.best_for != blank -%}<div class="ing-fact"><dt>Best for</dt><dd>{{ block.settings.best_for | escape }}</dd></div>{%- endif -%}
            {%- if block.settings.pairs != blank -%}<div class="ing-fact"><dt>Pairs well with</dt><dd>{{ block.settings.pairs | escape }}</dd></div>{%- endif -%}
          {%- endcapture -%}
          {%- if facts != blank -%}<dl class="ing-facts">{{ facts }}</dl>{%- endif -%}
          {%- if block.settings.science != blank or block.settings.how_to_use != blank -%}
            <div class="ing-more">
              {%- if block.settings.science != blank -%}
                <div class="accordion-item">
                  <button type="button" class="accordion-trigger" aria-expanded="false">{{ block.settings.science_title | default: 'The science' | escape }} <span class="plus" aria-hidden="true">+</span></button>
                  <div class="accordion-panel"><div class="accordion-panel-inner"><div class="rte">{{ block.settings.science }}</div></div></div>
                </div>
              {%- endif -%}
              {%- if block.settings.how_to_use != blank -%}
                <div class="accordion-item">
                  <button type="button" class="accordion-trigger" aria-expanded="false">{{ block.settings.how_title | default: 'How to use it' | escape }} <span class="plus" aria-hidden="true">+</span></button>
                  <div class="accordion-panel"><div class="accordion-panel-inner"><div class="rte">{{ block.settings.how_to_use }}</div></div></div>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if ing_product != blank and block.settings.link_label != blank -%}
            <a href="{{ ing_product.url }}" class="text-link">{{ block.settings.link_label | escape }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Ingredient details",
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Uses the product's image and links to it." },
        { "type": "image_picker", "id": "image", "label": "Image (overrides product image)" },
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "Growth & circulation" },
        { "type": "text", "id": "name", "label": "Name", "default": "Rosemary" },
        { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "Defaults to the name, e.g. /pages/ingredients#rosemary" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe what this ingredient does and why it earned its place.</p>" },
        { "type": "text", "id": "benefits", "label": "Benefits", "info": "Comma-separated", "default": "Scalp circulation, Follicle strength, Calms irritation" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Shop the concentrate" },
        { "type": "header", "content": "Fact sheet" },
        { "type": "text", "id": "botanical", "label": "Botanical name" },
        { "type": "text", "id": "origin", "label": "Origin" },
        { "type": "text", "id": "compounds", "label": "Key compounds" },
        { "type": "text", "id": "preparation", "label": "How we prepare it" },
        { "type": "text", "id": "best_for", "label": "Best for" },
        { "type": "text", "id": "pairs", "label": "Pairs well with" },
        { "type": "header", "content": "Read more" },
        { "type": "text", "id": "science_title", "label": "Science panel title", "default": "The science" },
        { "type": "richtext", "id": "science", "label": "The science" },
        { "type": "text", "id": "how_title", "label": "How-to panel title", "default": "How to use it" },
        { "type": "richtext", "id": "how_to_use", "label": "How to use it" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Ingredient details", "blocks": [{ "type": "ingredient" }] }]
}
{% endschema %}
