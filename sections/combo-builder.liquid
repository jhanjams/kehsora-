{%- comment -%}
  COMBO BUILDER — product page for combo offers ("Any 3 for ₹1,350", etc.).
  The combo itself is a normal Shopify product with its own price. Shoppers
  pick which concentrates they want; the picks are saved on the cart line and
  order as line item properties ("Concentrate 1: Rosemary …").

  Combos are detected by snippets/combo-meta (title or tags), so
  "Any 2 Concentrates + Base Oil – Combo Offer" picks 2 and adds the base oil.
  Sits on the normal product template and only appears for combo products
  (main-product hides itself for those), so no template switching.
{%- endcomment -%}
{%- liquid
  capture product_meta
    render 'combo-meta', product: product
  endcapture
  assign is_combo_product = false
  if product_meta contains "true|"
    assign is_combo_product = true
  endif
  assign show_builder = is_combo_product
  if section.settings.require_combo_tag == false
    assign show_builder = true
  endif
-%}
{%- if show_builder -%}
{{ 'kehsora-combo.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign main_alt = featured_media.alt | default: product.title
-%}

<div class="container">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">{{ 'sections.header.home' | t }}</a> &nbsp;/&nbsp;
    <a href="{{ routes.all_products_collection_url }}">{{ 'products.product.shop' | t }}</a> &nbsp;/&nbsp;
    <span class="current">{{ product.title | escape }}</span>
  </nav>
</div>

<section class="section" style="padding-top: 2rem;" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="pdp">

      <div class="pdp-gallery">
        <div class="pdp-gallery-main" data-gallery-main>
          {%- if featured_media -%}
            {{ featured_media.preview_image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 860px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: main_alt }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="pdp-thumbs">
            {%- for media in product.media -%}
              {%- capture media_srcset -%}
                {{- media.preview_image | image_url: width: 600 }} 600w, {{ media.preview_image | image_url: width: 900 }} 900w, {{ media.preview_image | image_url: width: 1400 }} 1400w
              {%- endcapture -%}
              {%- assign thumb_alt = media.alt | default: product.title -%}
              <button type="button" class="pdp-thumb{% if media.id == featured_media.id %} active{% endif %}" data-media-id="{{ media.id }}" data-src="{{ media.preview_image | image_url: width: 1400 }}" data-srcset="{{ media_srcset | strip }}" data-alt="{{ thumb_alt | escape }}" aria-label="{{ 'products.product.view_image' | t: number: forloop.index }}">
                {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div>
        <div class="pdp-kicker">{{ section.settings.kicker | upcase | escape }}</div>
        <h1>{{ product.title | escape }}</h1>

        {% render 'price', product: product, variant: current_variant, class: 'pdp-price-row' %}

        {%- if product.description != blank -%}
          <div class="pdp-desc rte">{{ product.description }}</div>
        {%- endif -%}

        {% render 'combo-picker', combo: product, cfg: section.settings, uid: section.id %}

        {%- if section.settings.note != blank -%}
          <div class="pdp-perks"><div class="pdp-perk">{% render 'icon', name: 'leaf', size: 16 %} {{ section.settings.note | escape }}</div></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script src="{{ 'kehsora-combo.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Combo builder",
  "settings": [
    { "type": "paragraph", "content": "Combos are recognised from their title: “Any 2 Concentrates – Combo Offer” lets shoppers pick 2, “3 Concentrates” picks 3, “All 5” includes everything, and “Base Oil” in the title adds the base oil. Tags (combo, pick-2, with-base-oil) also work and win over the title." },
    { "type": "checkbox", "id": "require_combo_tag", "label": "Only show for combo products", "default": true, "info": "Lets this section sit on the normal product template: regular products are unaffected." },
    { "type": "range", "id": "default_pick", "label": "Concentrates to choose (when no pick- tag)", "min": 1, "max": 10, "step": 1, "default": 3 },
    { "type": "product_list", "id": "choices", "label": "Concentrates to choose from", "limit": 12, "info": "Leave empty to use every product whose title contains the text below." },
    { "type": "text", "id": "match_text", "label": "Match products whose title contains", "default": "Concentrate" },
    { "type": "text", "id": "name_strip", "label": "Shorten names by removing", "default": " Hair Oil Concentrate" },
    { "type": "text", "id": "size_match", "label": "Concentrate size used for “worth” price", "info": "e.g. 30ml. Leave empty to use each product's first variant." },
    { "type": "header", "content": "Base oil" },
    { "type": "product", "id": "base_oil", "label": "Base oil product", "info": "Used for combos tagged with-base-oil. Leave empty to find the product whose title contains the text below." },
    { "type": "text", "id": "base_oil_match", "label": "Base oil title contains", "default": "Base Oil" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Combo offer" },
    { "type": "text", "id": "choose_label", "label": "Choose label", "default": "Choose any [count] concentrates" },
    { "type": "text", "id": "all_label", "label": "All-included label", "default": "All [count] concentrates included" },
    { "type": "text", "id": "included_label", "label": "Included label", "default": "Also included" },
    { "type": "text", "id": "included_note", "label": "Included item note", "default": "Included in this combo" },
    { "type": "text", "id": "more_label", "label": "Button while choosing", "default": "Choose [count] more" },
    { "type": "text", "id": "savings_text", "label": "Savings line", "default": "Worth [worth] separately — you save [save]", "info": "Shown when the combo costs less than buying separately." },
    { "type": "text", "id": "note", "label": "Note under buttons", "default": "Each concentrate is packed and shipped together" },
    { "type": "text", "id": "empty_hint", "label": "Message when no concentrates are found", "default": "No concentrates found — pick them in the theme editor under “Concentrates to choose from”." },
    { "type": "header", "content": "Order labels" },
    { "type": "text", "id": "property_label", "label": "Cart / order label for each pick", "default": "Concentrate" },
    { "type": "text", "id": "includes_property_label", "label": "Cart / order label for included items", "default": "Includes" }
  ]
}
{% endschema %}
