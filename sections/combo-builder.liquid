{%- comment -%}
  COMBO BUILDER — product page for combo offers ("Any 3 for ₹1,350", etc.).
  The combo itself is a normal Shopify product with its own price. Shoppers
  pick which concentrates they want; the picks are saved on the cart line and
  order as line item properties ("Concentrate 1: Rosemary …").

  Configure each combo product with tags:
    combo          → marks it as a combo (cards show "Build your combo")
    pick-2 / pick-3 / pick-5 → how many concentrates to choose
    with-base-oil  → the base oil is included automatically
  Sits on the normal product template and only appears for products tagged
  "combo" (main-product hides itself for those), so no template switching.
{%- endcomment -%}
{%- liquid
  assign is_combo_product = false
  for tag in product.tags
    assign tag_lower = tag | downcase | strip
    if tag_lower == 'combo'
      assign is_combo_product = true
    endif
  endfor
  assign show_builder = is_combo_product
  if section.settings.require_combo_tag == false
    assign show_builder = true
  endif
-%}
{%- if show_builder -%}
{{ 'kehsora-combo.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign pick_count = section.settings.default_pick
  assign with_base = false
  for tag in product.tags
    assign t = tag | downcase | strip
    if t contains 'pick-'
      assign n = t | remove: 'pick-' | plus: 0
      if n > 0
        assign pick_count = n
      endif
    endif
    if t == 'with-base-oil'
      assign with_base = true
    endif
  endfor

  assign match_text = section.settings.match_text | downcase
  assign choice_list = section.settings.choices
  assign use_list = false
  if choice_list != blank and choice_list.size > 0
    assign use_list = true
  endif

  comment
    Count the available choices (from the picked list, or all products whose
    title contains the match text and that are not combos themselves).
  endcomment
  assign choice_count = 0
  if use_list
    assign choice_count = choice_list.size
  else
    for p in collections.all.products
      assign p_title = p.title | downcase
      if p.id != product.id and p_title contains match_text
        assign is_c = false
        for pt in p.tags
          assign ptl = pt | downcase
          if ptl == 'combo'
            assign is_c = true
          endif
        endfor
        unless is_c
          assign choice_count = choice_count | plus: 1
        endunless
      endif
    endfor
  endif

  assign all_included = false
  if pick_count >= choice_count and choice_count > 0
    assign all_included = true
    assign pick_count = choice_count
  endif

  assign base_oil = section.settings.base_oil
  if with_base and base_oil == blank
    assign base_match = section.settings.base_oil_match | downcase
    for p in collections.all.products
      assign p_title = p.title | downcase
      if p.id != product.id and p_title contains base_match
        assign base_is_combo = false
        for pt in p.tags
          assign ptl = pt | downcase
          if ptl == 'combo'
            assign base_is_combo = true
          endif
        endfor
        unless base_is_combo
          assign base_oil = p
          break
        endunless
      endif
    endfor
  endif

  assign current_variant = product.selected_or_first_available_variant
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign main_alt = featured_media.alt | default: product.title
  assign size_match = section.settings.size_match | downcase
  assign combo_form_id = 'combo-form-' | append: section.id
-%}

<div class="container">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.root_url }}">{{ 'sections.header.home' | t }}</a> &nbsp;/&nbsp;
    <a href="{{ routes.all_products_collection_url }}">{{ 'products.product.shop' | t }}</a> &nbsp;/&nbsp;
    <span class="current">{{ product.title | escape }}</span>
  </nav>
</div>

<section class="section" style="padding-top: 2rem;" data-combo data-section-id="{{ section.id }}">
  <div class="container">
    <div class="pdp">

      <div class="pdp-gallery">
        <div class="pdp-gallery-main" data-gallery-main>
          {%- if featured_media -%}
            {{ featured_media.preview_image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 860px) 55vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: main_alt }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <div class="pdp-thumbs">
            {%- for media in product.media -%}
              {%- capture media_srcset -%}
                {{- media.preview_image | image_url: width: 600 }} 600w, {{ media.preview_image | image_url: width: 900 }} 900w, {{ media.preview_image | image_url: width: 1400 }} 1400w
              {%- endcapture -%}
              {%- assign thumb_alt = media.alt | default: product.title -%}
              <button type="button" class="pdp-thumb{% if media.id == featured_media.id %} active{% endif %}" data-media-id="{{ media.id }}" data-src="{{ media.preview_image | image_url: width: 1400 }}" data-srcset="{{ media_srcset | strip }}" data-alt="{{ thumb_alt | escape }}" aria-label="{{ 'products.product.view_image' | t: number: forloop.index }}">
                {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div>
        <div class="pdp-kicker">{{ section.settings.kicker | upcase | escape }}</div>
        <h1>{{ product.title | escape }}</h1>

        {% render 'price', product: product, variant: current_variant, class: 'pdp-price-row' %}

        {%- if product.description != blank -%}
          <div class="pdp-desc rte">{{ product.description }}</div>
        {%- endif -%}

        {%- form 'product', product, id: combo_form_id, class: 'combo-form', data-combo-form: '', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-combo-price="{{ current_variant.price }}">

          <div class="combo-head">
            <span class="label-sm">
              {%- if all_included -%}
                {{ section.settings.all_label | replace: '[count]', choice_count | escape }}
              {%- else -%}
                {{ section.settings.choose_label | replace: '[count]', pick_count | escape }}
              {%- endif -%}
            </span>
            {%- unless all_included -%}
              <span class="combo-counter" data-combo-counter aria-live="polite"><span data-combo-selected>0</span> / {{ pick_count }}</span>
            {%- endunless -%}
          </div>

          <div class="combo-choices{% if all_included %} is-locked{% endif %}" data-combo-choices data-pick="{{ pick_count }}" data-all="{{ all_included }}">
            {%- if use_list -%}
              {%- for p in choice_list -%}
                {% render 'combo-choice', choice: p, size_match: size_match, strip_text: section.settings.name_strip, locked: all_included %}
              {%- endfor -%}
            {%- else -%}
              {%- for p in collections.all.products -%}
                {%- liquid
                  assign p_title = p.title | downcase
                  assign skip = false
                  if p.id == product.id
                    assign skip = true
                  endif
                  unless p_title contains match_text
                    assign skip = true
                  endunless
                  for pt in p.tags
                    assign ptl = pt | downcase
                    if ptl == 'combo'
                      assign skip = true
                    endif
                  endfor
                -%}
                {%- unless skip -%}
                  {% render 'combo-choice', choice: p, size_match: size_match, strip_text: section.settings.name_strip, locked: all_included %}
                {%- endunless -%}
              {%- endfor -%}
            {%- endif -%}
          </div>

          {%- if choice_count == 0 -%}
            <p class="editor-hint">{{ section.settings.empty_hint | escape }}</p>
          {%- endif -%}

          {%- if with_base and base_oil != blank -%}
            {%- liquid
              assign base_variant = base_oil.selected_or_first_available_variant
            -%}
            <div class="combo-head" style="margin-top: 1.6rem;"><span class="label-sm">{{ section.settings.included_label | escape }}</span></div>
            <div class="combo-choices is-locked">
              <div class="combo-choice is-selected is-included" data-combo-included data-title="{{ base_oil.title | escape }}" data-value="{{ base_variant.price }}">
                <span class="combo-choice-img">
                  {%- if base_oil.featured_media -%}
                    {{ base_oil.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </span>
                <span class="combo-choice-text">
                  <span class="combo-choice-name">{{ base_oil.title | escape }}</span>
                  <span class="combo-choice-meta">{{ section.settings.included_note | escape }}</span>
                </span>
                <span class="combo-check" aria-hidden="true"></span>
              </div>
            </div>
          {%- elsif with_base -%}
            <div class="combo-head" style="margin-top: 1.6rem;"><span class="label-sm">{{ section.settings.included_label | escape }}</span></div>
            <div class="combo-choices is-locked">
              <div class="combo-choice is-selected is-included" data-combo-included data-title="{{ section.settings.base_oil_match | escape }}" data-value="0">
                <span class="combo-choice-text"><span class="combo-choice-name">{{ section.settings.base_oil_match | escape }}</span></span>
                <span class="combo-check" aria-hidden="true"></span>
              </div>
            </div>
          {%- endif -%}

          <p class="combo-savings" data-combo-savings hidden></p>

          <div class="pdp-actions">
            <div class="qty qty-lg">
              <button type="button" data-qty-step="-1" aria-label="{{ 'cart.decrease_generic' | t }}">&minus;</button>
              <input type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'cart.quantity' | t }}">
              <button type="button" data-qty-step="1" aria-label="{{ 'cart.increase_generic' | t }}">+</button>
            </div>
            <button type="submit" class="btn btn-ghost-gold" data-combo-add disabled
              data-label-add="{{ 'products.product.add_to_cart' | t | escape }}"
              data-label-more="{{ section.settings.more_label | escape }}"
              data-label-soldout="{{ 'products.product.sold_out' | t | escape }}"
              data-available="{{ current_variant.available }}">
              {%- if current_variant.available -%}{{ section.settings.more_label | replace: '[count]', pick_count | escape }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
            </button>
            <button type="button" class="btn btn-gold" data-combo-buy disabled>{{ 'products.product.buy_now' | t }}</button>
          </div>
        {%- endform -%}

        {%- if section.settings.note != blank -%}
          <div class="pdp-perks"><div class="pdp-perk">{% render 'icon', name: 'leaf', size: 16 %} {{ section.settings.note | escape }}</div></div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script type="application/json" data-combo-config>
  {
    "moneyFormat": {{ shop.money_format | json }},
    "propertyLabel": {{ section.settings.property_label | json }},
    "includesLabel": {{ section.settings.includes_property_label | json }},
    "savingsText": {{ section.settings.savings_text | json }}
  }
</script>
<script src="{{ 'kehsora-combo.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Combo builder",
  "settings": [
    { "type": "paragraph", "content": "Tag combo products with: combo, pick-2 / pick-3 / pick-5, and with-base-oil when the base oil is included. Price the combo product itself (e.g. ₹1,350)." },
    { "type": "checkbox", "id": "require_combo_tag", "label": "Only show for products tagged “combo”", "default": true, "info": "Lets this section sit on the normal product template: regular products are unaffected." },
    { "type": "range", "id": "default_pick", "label": "Concentrates to choose (when no pick- tag)", "min": 1, "max": 10, "step": 1, "default": 3 },
    { "type": "product_list", "id": "choices", "label": "Concentrates to choose from", "limit": 12, "info": "Leave empty to use every product whose title contains the text below." },
    { "type": "text", "id": "match_text", "label": "Match products whose title contains", "default": "Concentrate" },
    { "type": "text", "id": "name_strip", "label": "Shorten names by removing", "default": " Hair Oil Concentrate" },
    { "type": "text", "id": "size_match", "label": "Concentrate size used for “worth” price", "default": "", "info": "e.g. 30ml. Leave empty to use each product's first variant." },
    { "type": "header", "content": "Base oil" },
    { "type": "product", "id": "base_oil", "label": "Base oil product", "info": "Used for combos tagged with-base-oil. Leave empty to find the product whose title contains the text below." },
    { "type": "text", "id": "base_oil_match", "label": "Base oil title contains", "default": "Base Oil" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Combo offer" },
    { "type": "text", "id": "choose_label", "label": "Choose label", "default": "Choose any [count] concentrates" },
    { "type": "text", "id": "all_label", "label": "All-included label", "default": "All [count] concentrates included" },
    { "type": "text", "id": "included_label", "label": "Included label", "default": "Also included" },
    { "type": "text", "id": "included_note", "label": "Included item note", "default": "Included in this combo" },
    { "type": "text", "id": "more_label", "label": "Button while choosing", "default": "Choose [count] more" },
    { "type": "text", "id": "savings_text", "label": "Savings line", "default": "Worth [worth] separately — you save [save]", "info": "Shown when the combo costs less than buying separately." },
    { "type": "text", "id": "note", "label": "Note under buttons", "default": "Each concentrate is packed and shipped together" },
    { "type": "text", "id": "empty_hint", "label": "Message when no concentrates are found", "default": "No concentrates found — pick them in the theme editor under “Concentrates to choose from”." },
    { "type": "header", "content": "Order labels" },
    { "type": "text", "id": "property_label", "label": "Cart / order label for each pick", "default": "Concentrate" },
    { "type": "text", "id": "includes_property_label", "label": "Cart / order label for included items", "default": "Includes" }
  ]
}
{% endschema %}
