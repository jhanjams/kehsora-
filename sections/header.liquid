{%- liquid
  assign menu_links = section.settings.menu.links
  assign logo_text = section.settings.logo_text | default: shop.name
  assign use_builtin = true
  if section.settings.nav_source == 'menu' and menu_links.size > 0
    assign use_builtin = false
  endif
-%}
{%- capture builtin_left -%}
  <a href="{{ routes.all_products_collection_url }}" class="nav-link">{{ section.settings.label_shop | escape }}</a>
  <a href="{{ routes.root_url }}#combos" class="nav-link">{{ section.settings.label_combos | escape }}</a>
  <a href="{% render 'safe-url', url: '/pages/ingredients' %}" class="nav-link">{{ section.settings.label_ingredients | escape }}</a>
{%- endcapture -%}
{%- capture builtin_right -%}
  <a href="{{ routes.root_url }}#our-story" class="nav-link">{{ section.settings.label_story | escape }}</a>
  <a href="{% render 'safe-url', url: '/pages/contact' %}" class="nav-link">{{ section.settings.label_contact | escape }}</a>
{%- endcapture -%}
<header class="site-header" data-header>
  <div class="container nav-row">
    <nav class="nav-left" aria-label="{{ 'sections.header.menu' | t }}">
      {%- if use_builtin -%}
        {{ builtin_left }}
      {%- else -%}
        {%- for link in menu_links -%}
          <a href="{% render 'safe-url', url: link.url %}" class="nav-link"{% if link.current or link.child_current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {%- endfor -%}
      {%- endif -%}
    </nav>

    <a href="{{ routes.root_url }}" class="nav-logo" aria-label="{{ shop.name | escape }}">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_height = section.settings.logo_height -%}
        {%- assign logo_width = section.settings.logo.aspect_ratio | times: logo_height | round -%}
        {{ section.settings.logo | image_url: height: 160 | image_tag: height: logo_height, width: logo_width, alt: shop.name }}
      {%- else -%}
        {{ logo_text | escape }}
      {%- endif -%}
    </a>

    <div class="nav-right">
      {%- if use_builtin -%}<nav class="nav-right-links" aria-label="{{ 'sections.header.menu' | t }}">{{ builtin_right }}</nav>{%- endif -%}
      <div class="nav-icons">
        <button type="button" class="nav-icon-btn" data-search-open aria-label="{{ 'sections.header.search' | t }}">
          {% render 'icon', name: 'search', size: 19 %}
        </button>
        <a href="{{ routes.cart_url }}" class="nav-icon-btn" data-cart-open aria-label="{{ 'sections.header.cart' | t }}">
          {% render 'icon', name: 'bag', size: 20 %}
          <span class="cart-count{% if cart.item_count > 0 %} has-items{% endif %}" data-cart-count>{{ cart.item_count }}</span>
        </a>
        <button type="button" class="mobile-menu-btn nav-icon-btn" data-mobile-menu-btn aria-label="{{ 'sections.header.open_menu' | t }}" aria-expanded="false">
          {% render 'icon', name: 'menu', size: 20 %}
        </button>
      </div>
    </div>
  </div>
</header>

<nav class="mobile-nav" data-mobile-nav aria-label="{{ 'sections.header.mobile_menu' | t }}">
  <button type="button" class="nav-icon-btn mobile-nav-close" data-mobile-nav-close aria-label="{{ 'sections.header.close_menu' | t }}">
    {% render 'icon', name: 'close', size: 22 %}
  </button>
  <a href="{{ routes.root_url }}">{{ 'sections.header.home' | t }}</a>
  {%- if use_builtin -%}
    {{ builtin_left | append: builtin_right | replace: ' class="nav-link"', '' }}
  {%- else -%}
    {%- for link in menu_links -%}
      <a href="{% render 'safe-url', url: link.url %}">{{ link.title | escape }}</a>
    {%- endfor -%}
  {%- endif -%}
  {%- if shop.customer_accounts_enabled -%}
    <a href="{{ routes.account_url }}">{{ 'sections.header.account' | t }}</a>
  {%- endif -%}
</nav>

<div class="search-overlay" data-search role="dialog" aria-modal="true" aria-label="{{ 'sections.header.search' | t }}">
  <button type="button" class="nav-icon-btn search-close" data-search-close aria-label="{{ 'sections.header.close_search' | t }}">
    {% render 'icon', name: 'close', size: 22 %}
  </button>
  <form action="{{ routes.search_url }}" method="get" role="search">
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder | escape }}" aria-label="{{ 'sections.header.search' | t }}" autocomplete="off">
    <div class="search-hint">{{ 'sections.header.search_hint' | t }}</div>
    {%- assign suggestions = section.settings.search_suggestions | split: ',' -%}
    {%- if section.settings.search_suggestions != blank -%}
      <div class="search-suggest">
        {%- for term in suggestions -%}
          {%- assign t_term = term | strip -%}
          <a href="{{ routes.search_url }}?q={{ t_term | url_encode }}&type=product&options%5Bprefix%5D=last">{{ t_term | escape }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </form>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "select", "id": "nav_source", "label": "Navigation", "default": "kehsora", "options": [
      { "value": "kehsora", "label": "Kehsora links (built in)" },
      { "value": "menu", "label": "A Shopify menu" }
    ], "info": "Kehsora links: Shop All, Combos, Ingredients, Our Story, Contact." },
    { "type": "text", "id": "label_shop", "label": "Label: Shop All", "default": "Shop All" },
    { "type": "text", "id": "label_combos", "label": "Label: Combos", "default": "Combos" },
    { "type": "text", "id": "label_ingredients", "label": "Label: Ingredients", "default": "Ingredients" },
    { "type": "text", "id": "label_story", "label": "Label: Our Story", "default": "Our Story" },
    { "type": "text", "id": "label_contact", "label": "Label: Contact", "default": "Contact" },
    { "type": "link_list", "id": "menu", "label": "Shopify menu", "default": "main-menu", "info": "Used when Navigation is set to “A Shopify menu”." },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "kehsora", "info": "Set in the Kehsora brand font. Used when no logo image is uploaded." },
    { "type": "image_picker", "id": "logo", "label": "Logo image (optional)" },
    { "type": "range", "id": "logo_height", "label": "Logo image height", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 40 },
    { "type": "header", "content": "Search" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search rosemary, hair fall, scalp…" },
    { "type": "text", "id": "search_suggestions", "label": "Suggested searches", "default": "Hair fall, Dandruff, Growth, Shine, Rosemary", "info": "Comma-separated" }
  ]
}
{% endschema %}
