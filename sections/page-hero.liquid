{%- liquid
  assign hero_heading = section.settings.heading
  if hero_heading == blank and section.settings.heading_emphasis == blank
    assign hero_heading = page.title | default: collection.title
  endif
-%}
<section class="page-hero"{% if section.settings.compact %} style="padding-bottom: 2rem;"{% endif %}>
  {%- if section.settings.show_mandala -%}
    {% render 'mandala', class: 'hero-mandala', id: section.id, petals: 12 %}
  {%- endif -%}
  <div class="container">
    {%- if section.settings.eyebrow != blank -%}<div class="section-eyebrow center fade-up d0">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
    {% render 'heading', tag: 'h1', text: hero_heading, emphasis: section.settings.heading_emphasis, class: 'fade-up d1' %}
    {%- if section.settings.text != blank -%}<p class="fade-up d2">{{ section.settings.text | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page header",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave both heading fields empty to use the page title." },
    { "type": "text", "id": "heading_emphasis", "label": "Heading (italic gold part)" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_mandala", "label": "Show mandala", "default": true },
    { "type": "checkbox", "id": "compact", "label": "Less space below", "default": false }
  ],
  "presets": [{ "name": "Page header" }]
}
{% endschema %}
