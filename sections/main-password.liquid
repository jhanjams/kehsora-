<section class="hero" style="margin-top: 0; padding-top: 0; min-height: 100svh;">
  {% render 'mandala', class: 'hero-mandala', id: section.id, petals: 12 %}
  <div class="hero-content">
    <div class="hero-eyebrow fade-up d0">{{ section.settings.eyebrow | escape }}</div>
    <h1><span class="line"><span>{{ shop.name | escape }}</span></span></h1>
    {%- if shop.password_message != blank -%}<p class="fade-up d1">{{ shop.password_message | escape }}</p>{%- endif -%}
    <div class="fade-up d2" style="max-width: 30rem; margin: 2.4rem auto 0;">
      {%- form 'customer', class: 'newsletter-form-wrap' -%}
        <input type="hidden" name="contact[tags]" value="prospect,password page">
        {%- if form.posted_successfully? -%}
          <p class="form-success">{{ 'general.password_page.thanks' | t }}</p>
        {%- else -%}
          <div class="newsletter-form">
            <input type="email" name="contact[email]" placeholder="{{ 'sections.newsletter.email' | t }}" aria-label="{{ 'sections.newsletter.email' | t }}" required>
            <button type="submit" class="btn btn-gold">{{ 'general.password_page.notify' | t }}</button>
          </div>
        {%- endif -%}
      {%- endform -%}
      <details style="margin-top: 3rem; color: var(--cream-faint); font-size: 0.8rem;">
        <summary style="cursor: pointer; letter-spacing: 0.2em; text-transform: uppercase;">{{ 'general.password_page.owner' | t }}</summary>
        {%- form 'storefront_password', class: 'newsletter-form-wrap' -%}
          {%- if form.errors -%}<div class="form-message form-message--error">{{ form.errors | default_errors }}</div>{%- endif -%}
          <div class="newsletter-form">
            <input type="password" name="password" placeholder="{{ 'general.password_page.password' | t }}" aria-label="{{ 'general.password_page.password' | t }}" required>
            <button type="submit" class="btn btn-outline">{{ 'general.password_page.enter' | t }}</button>
          </div>
        {%- endform -%}
      </details>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Opening soon" }
  ]
}
{% endschema %}
