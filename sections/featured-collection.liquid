{%- liquid
  assign featured = section.settings.collection
  if featured == blank
    assign featured = collections['all']
  endif
  assign limit = section.settings.products_to_show
-%}
<section class="section" id="{{ section.settings.anchor | default: section.id | handle }}">
  <div class="container">
    <div class="section-head reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="section-eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        {% render 'heading', tag: 'h2', text: section.settings.heading, emphasis: section.settings.heading_emphasis %}
      </div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: featured.url }}" class="btn btn-outline btn-sm">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>

    <div class="product-grid reveal-stagger">
      {%- if featured.products_count > 0 -%}
        {%- liquid
          assign shown = 0
          assign only_match = section.settings.only_match | downcase | strip
          if only_match != blank
            assign match_found = false
            for product in featured.products
              assign p_title = product.title | downcase
              if p_title contains only_match
                assign match_found = true
                break
              endif
            endfor
            unless match_found
              assign only_match = ''
            endunless
          endif
        -%}
        {%- for product in featured.products -%}
          {%- if shown >= limit -%}{%- break -%}{%- endif -%}
          {%- if only_match != blank -%}
            {%- assign p_title = product.title | downcase -%}
            {%- unless p_title contains only_match -%}{%- continue -%}{%- endunless -%}
          {%- endif -%}
          {%- if section.settings.hide_combos -%}
            {%- capture p_meta -%}{% render 'combo-meta', product: product %}{%- endcapture -%}
            {%- if p_meta contains "true|" -%}{%- continue -%}{%- endif -%}
          {%- endif -%}
          {% render 'product-card', card_product: product %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          {% render 'product-card', card_product: blank %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The crowd favourites" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Formulated for" },
    { "type": "text", "id": "heading_emphasis", "label": "Heading (italic gold part)", "default": "real results" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "checkbox", "id": "hide_combos", "label": "Hide combo offers", "default": true },
    { "type": "text", "id": "only_match", "label": "Only show products whose title contains", "info": "e.g. Concentrate. Leave empty to show every product." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore All" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "bestsellers", "info": "Lets menus link to this section, e.g. /#bestsellers" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
