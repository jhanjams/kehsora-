<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="section-eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        {% render 'heading', tag: 'h2', text: section.settings.heading, emphasis: section.settings.heading_emphasis %}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div data-tabs class="reveal">
        <div class="concern-tabs" role="tablist">
          {%- for block in section.blocks -%}
            <button type="button" class="concern-tab{% if forloop.first %} active{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="panel-{{ block.id }}" data-target="panel-{{ block.id }}">{{ block.settings.label | escape }}</button>
          {%- endfor -%}
        </div>

        {%- for block in section.blocks -%}
          {%- liquid
            comment
              Products: the ones picked in the editor, otherwise the first
              non-combo products whose title contains one of the keywords.
            endcomment
            assign picked = ''
            assign first_product = nil
            if block.settings.product != blank and block.settings.product.id != blank
              assign picked = picked | append: block.settings.product.handle | append: ','
              assign first_product = block.settings.product
            endif
            if block.settings.product_2 != blank and block.settings.product_2.id != blank
              assign picked = picked | append: block.settings.product_2.handle | append: ','
              if first_product == nil
                assign first_product = block.settings.product_2
              endif
            endif
            if picked == ''
              assign words = block.settings.keywords | downcase | split: ','
              for w in words
                assign kw = w | strip
                if kw == blank
                  continue
                endif
                for p in collections.all.products
                  assign p_title = p.title | downcase
                  if p_title contains kw
                    capture p_meta
                      render 'combo-meta', product: p
                    endcapture
                    unless p_meta contains "true|"
                      assign p_key = p.handle | append: ','
                      unless picked contains p_key
                        assign picked = picked | append: p_key
                        if first_product == nil
                          assign first_product = p
                        endif
                      endunless
                      break
                    endunless
                  endif
                endfor
              endfor
            endif
            assign picked = picked | split: ','
          -%}
          <div class="concern-panel{% if forloop.first %} active{% endif %}" id="panel-{{ block.id }}" role="tabpanel" {{ block.shopify_attributes }}>
            <div class="concern-layout{% if picked.size > 1 %} has-pair{% endif %}">
              <div class="concern-cards">
                {%- if picked.size > 0 -%}
                  {%- for h in picked limit: 2 -%}
                    {% render 'product-card', card_product: all_products[h] %}
                  {%- endfor -%}
                {%- else -%}
                  {% render 'product-card', card_product: blank %}
                {%- endif -%}
              </div>
              <div class="concern-story">
                {%- if block.settings.eyebrow != blank -%}<div class="section-eyebrow">{{ block.settings.eyebrow | escape }}</div>{%- endif -%}
                {% render 'heading', tag: 'h3', text: block.settings.heading, emphasis: block.settings.heading_emphasis %}
                <div class="rte">{{ block.settings.text }}</div>
                {%- if block.settings.link_label != blank -%}
                  {%- if picked.size > 1 -%}
                    <a href="{{ routes.all_products_collection_url }}" class="text-link">{{ block.settings.link_label_pair | default: block.settings.link_label | escape }}</a>
                  {%- elsif first_product != nil -%}
                    <a href="{{ first_product.url }}" class="text-link">{{ block.settings.link_label | escape }}</a>
                  {%- endif -%}
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by concern",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curate your hair care" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by" },
    { "type": "text", "id": "heading_emphasis", "label": "Heading (italic gold part)", "default": "concern" }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Hair Fall" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "product", "id": "product_2", "label": "Second product (optional)" },
        { "type": "text", "id": "keywords", "label": "…or products whose title contains", "default": "Bhringraj", "info": "Used when no product is picked. Comma separated — up to two, e.g. Bhringraj, Rosemary" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Bhringraj?" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "The" },
        { "type": "text", "id": "heading_emphasis", "label": "Heading (italic gold part)", "default": "ruler of hair" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell the story of this ingredient.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover the concentrate" },
        { "type": "text", "id": "link_label_pair", "label": "Link label with two products", "default": "Shop the concentrates" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shop by concern",
      "blocks": [
        { "type": "concern", "settings": { "label": "Hair Fall" } },
        { "type": "concern", "settings": { "label": "Dandruff & Scalp" } }
      ]
    }
  ]
}
{% endschema %}
