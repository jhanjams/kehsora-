<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="section-eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        {% render 'heading', tag: 'h2', text: section.settings.heading, emphasis: section.settings.heading_emphasis %}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div data-tabs class="reveal">
        <div class="concern-tabs" role="tablist">
          {%- for block in section.blocks -%}
            <button type="button" class="concern-tab{% if forloop.first %} active{% endif %}" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="panel-{{ block.id }}" data-target="panel-{{ block.id }}">{{ block.settings.label | escape }}</button>
          {%- endfor -%}
        </div>

        {%- for block in section.blocks -%}
          <div class="concern-panel{% if forloop.first %} active{% endif %}" id="panel-{{ block.id }}" role="tabpanel" {{ block.shopify_attributes }}>
            <div class="concern-layout">
              {%- if block.settings.product != blank -%}
                {% render 'product-card', card_product: block.settings.product %}
              {%- else -%}
                {% render 'product-card', card_product: blank %}
              {%- endif -%}
              <div class="concern-story">
                {%- if block.settings.eyebrow != blank -%}<div class="section-eyebrow">{{ block.settings.eyebrow | escape }}</div>{%- endif -%}
                {% render 'heading', tag: 'h3', text: block.settings.heading, emphasis: block.settings.heading_emphasis %}
                <div class="rte">{{ block.settings.text }}</div>
                {%- if block.settings.link_label != blank and block.settings.product != blank -%}
                  <a href="{{ block.settings.product.url }}" class="text-link">{{ block.settings.link_label | escape }}</a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by concern",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curate your hair care" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by" },
    { "type": "text", "id": "heading_emphasis", "label": "Heading (italic gold part)", "default": "concern" }
  ],
  "blocks": [
    {
      "type": "concern",
      "name": "Concern tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Hair Fall" },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Bhringraj?" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "The" },
        { "type": "text", "id": "heading_emphasis", "label": "Heading (italic gold part)", "default": "ruler of hair" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell the story of this ingredient.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover the concentrate" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shop by concern",
      "blocks": [
        { "type": "concern", "settings": { "label": "Hair Fall" } },
        { "type": "concern", "settings": { "label": "Dandruff & Scalp" } }
      ]
    }
  ]
}
{% endschema %}
