<footer class="site-footer">
  <div class="container">
    {%- if section.settings.show_contact -%}
      <div class="footer-contact-row">
        {%- if settings.contact_email != blank -%}
          <a href="mailto:{{ settings.contact_email }}" class="footer-contact-pill">{% render 'icon', name: 'mail', size: 16 %} {{ settings.contact_email }}</a>
        {%- endif -%}
        {%- if settings.contact_phone != blank -%}
          <a href="tel:{{ settings.contact_phone | remove: ' ' }}" class="footer-contact-pill">{% render 'icon', name: 'phone', size: 16 %} {{ 'sections.footer.call' | t }}: {{ settings.contact_phone }}</a>
        {%- endif -%}
        {%- if settings.whatsapp_number != blank -%}
          <a href="https://wa.me/{{ settings.whatsapp_number | remove: ' ' | remove: '+' }}" class="footer-contact-pill" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp', size: 16 %} {{ 'sections.footer.whatsapp' | t }}: {{ settings.whatsapp_display | default: settings.whatsapp_number }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="footer-grid">
      <div class="footer-col">
        <a href="{{ routes.root_url }}" class="footer-logo">{{ section.settings.logo_text | default: shop.name | escape }}</a>
        {%- if section.settings.tagline != blank -%}<p>{{ section.settings.tagline | escape }}</p>{%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        <div class="footer-col" {{ block.shopify_attributes }}>
          {%- if block.settings.heading != blank -%}<h5>{{ block.settings.heading | upcase | escape }}</h5>{%- endif -%}
          {%- for link in block.settings.menu.links -%}
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.show_wordmark -%}
      <div class="footer-wordmark" aria-hidden="true">{{ section.settings.logo_text | default: shop.name | escape }}</div>
    {%- endif -%}

    <div class="footer-bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}. {{ 'sections.footer.rights' | t }}</span>
      <span>{{ section.settings.signoff | escape }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "kehsora" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Ayurvedic hair care, reformulated. Real ingredients, real results — not trends." },
    { "type": "checkbox", "id": "show_contact", "label": "Show email, phone and WhatsApp", "default": true, "info": "Edit the details in Theme settings › Contact." },
    { "type": "checkbox", "id": "show_wordmark", "label": "Show large wordmark", "default": true },
    { "type": "text", "id": "signoff", "label": "Sign-off", "default": "Made with care, rooted in Ayurveda." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "max_blocks": 3
}
{% endschema %}
