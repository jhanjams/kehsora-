{%- liquid
  assign combos = section.settings.products
  assign use_list = false
  assign combo_total = 0
  if combos != blank and combos.size > 0
    assign use_list = true
    assign combo_total = combos.size
  else
    for p in collections.all.products
      for tag in p.tags
        assign tl = tag | downcase
        if tl == 'combo'
          assign combo_total = combo_total | plus: 1
        endif
      endfor
    endfor
  endif
-%}
{%- if combo_total > 0 or request.design_mode -%}
{{ 'kehsora-combo.css' | asset_url | stylesheet_tag }}
<section class="section combo-offers" id="{{ section.settings.anchor | default: 'combos' | handle }}" style="--combo-cols: {{ section.settings.columns }};">
  <div class="container">
    <div class="section-head reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="section-eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        {% render 'heading', tag: 'h2', text: section.settings.heading, emphasis: section.settings.heading_emphasis %}
        {%- if section.settings.text != blank -%}<p>{{ section.settings.text | escape }}</p>{%- endif -%}
      </div>
    </div>
    <div class="product-grid reveal-stagger">
      {%- if use_list -%}
        {%- for p in combos -%}
          {% render 'product-card', card_product: p %}
        {%- endfor -%}
      {%- else -%}
        {%- assign shown = 0 -%}
        {%- for p in collections.all.products -%}
          {%- assign p_is_combo = false -%}
          {%- for tag in p.tags -%}
            {%- assign tl = tag | downcase -%}
            {%- if tl == 'combo' -%}{%- assign p_is_combo = true -%}{%- endif -%}
          {%- endfor -%}
          {%- if p_is_combo -%}
            {% render 'product-card', card_product: p %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if shown == 0 and request.design_mode -%}
          <p class="editor-hint">Tag your combo products with “combo”, or pick them in this section’s settings.</p>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Combo offers",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Build your ritual" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Combo" },
    { "type": "text", "id": "heading_emphasis", "label": "Heading (italic gold part)", "default": "offers" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Pick the concentrates your hair needs — the more you combine, the more you save." },
    { "type": "product_list", "id": "products", "label": "Combos to show", "limit": 12, "info": "Leave empty to show every product tagged “combo”." },
    { "type": "select", "id": "columns", "label": "Columns on desktop", "default": "3", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "default": "combos", "info": "Menus can link here with /#combos" }
  ],
  "presets": [{ "name": "Combo offers" }]
}
{% endschema %}
