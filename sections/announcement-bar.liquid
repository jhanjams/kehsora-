{%- if section.blocks.size > 0 -%}
  <div class="marquee-band" aria-label="{{ 'sections.announcement.label' | t }}" {{ section.shopify_attributes }}>
    <div class="marquee-track" style="animation-duration: {{ section.settings.speed }}s;">
      {%- for i in (1..2) -%}
        {%- for repeat in (1..3) -%}
          {%- for block in section.blocks -%}
            <span {% if i == 1 and repeat == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{%- else -%}{{ block.settings.text | escape }}{%- endif -%}
            </span>
          {%- endfor -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement marquee",
  "class": "section-announcement",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "range", "id": "speed", "label": "Scroll duration (seconds)", "min": 20, "max": 120, "step": 5, "default": 60 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping above ₹999" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Announcement marquee",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Free shipping above ₹999" } },
        { "type": "announcement", "settings": { "text": "Plant powered, always" } },
        { "type": "announcement", "settings": { "text": "Rooted in Ayurveda" } }
      ]
    }
  ]
}
{% endschema %}
