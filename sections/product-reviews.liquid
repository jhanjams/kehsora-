{%- comment -%}
  PRODUCT REVIEWS — sits under every product. Add a review app's block here
  (Judge.me, Shopify Product Reviews, Loox…) for written, photo and video
  reviews. Until an app block is added, shoppers can still send a review
  through the store's contact form, and share photos or videos on WhatsApp.
{%- endcomment -%}
{%- liquid
  assign app_count = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_count = app_count | plus: 1
    endif
  endfor
  assign rating = product.metafields.reviews.rating.value
  assign wa = settings.whatsapp_number | remove: ' ' | remove: '+'
  assign review_form_id = 'review-form-' | append: section.id
-%}
<section class="section product-reviews" id="reviews">
  <div class="container">
    <div class="section-head reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<div class="section-eyebrow">{{ section.settings.eyebrow | escape }}</div>{%- endif -%}
        {% render 'heading', tag: 'h2', text: section.settings.heading, emphasis: section.settings.heading_emphasis %}
        {%- if rating != blank -%}
          <div class="reviews-summary">
            {% render 'rating', product: product %}
          </div>
        {%- elsif section.settings.text != blank -%}
          <p>{{ section.settings.text | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    {%- if app_count > 0 -%}
      <div class="reviews-app">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="reviews-fallback">
        <div class="reviews-share">
          <h3>{{ section.settings.share_heading | escape }}</h3>
          <p>{{ section.settings.share_text | escape }}</p>
          <ul class="reviews-kinds">
            <li>{% render 'icon', name: 'star', size: 18 %} {{ section.settings.kind_written | escape }}</li>
            <li>{% render 'icon', name: 'leaf', size: 18 %} {{ section.settings.kind_photo | escape }}</li>
            <li>{% render 'icon', name: 'heart', size: 18 %} {{ section.settings.kind_video | escape }}</li>
          </ul>
          {%- if wa != blank -%}
            {%- capture wa_text -%}{{ section.settings.whatsapp_message | replace: '[product]', product.title }}{%- endcapture -%}
            <a class="btn btn-ghost-gold btn-sm" href="https://wa.me/{{ wa }}?text={{ wa_text | url_encode }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp', size: 16 %} {{ section.settings.whatsapp_label | escape }}</a>
          {%- endif -%}
        </div>

        {%- form 'contact', id: review_form_id, class: 'review-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-success" role="status">{{ section.settings.success | escape }}</p>
          {%- else -%}
            {%- if form.errors -%}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
            <input type="hidden" name="contact[tags]" value="review">
            <input type="hidden" name="contact[Review for]" value="{{ product.title | escape }}">
            <fieldset class="review-stars">
              <legend class="label-sm">{{ section.settings.rating_label | escape }}</legend>
              <div class="review-stars-row">
              {%- for i in (1..5) reversed -%}
                <input type="radio" id="{{ review_form_id }}-r{{ i }}" name="contact[Rating]" value="{{ i }} / 5"{% if i == 5 %} checked{% endif %}>
                <label for="{{ review_form_id }}-r{{ i }}" aria-label="{{ i }} / 5">★</label>
              {%- endfor -%}
              </div>
            </fieldset>
            <div class="review-fields">
              <input class="field" type="text" name="contact[name]" placeholder="{{ 'sections.contact.name' | t }}" aria-label="{{ 'sections.contact.name' | t }}" autocomplete="name" required>
              <input class="field" type="email" name="contact[email]" placeholder="{{ 'sections.contact.email_address' | t }}" aria-label="{{ 'sections.contact.email_address' | t }}" autocomplete="email" required>
            </div>
            <textarea class="field" name="contact[body]" rows="4" placeholder="{{ section.settings.review_label | escape }}" aria-label="{{ section.settings.review_label | escape }}" required></textarea>
            <button type="submit" class="btn btn-gold btn-sm">{{ section.settings.submit_label | escape }}</button>
          {%- endif -%}
        {%- endform -%}
      </div>
      {%- if request.design_mode -%}
        <p class="editor-hint">For photo &amp; video reviews shown on this page, install a review app (Judge.me is free) and add its “Review widget” block to this section.</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product reviews",
  "settings": [
    { "type": "paragraph", "content": "Install a review app (e.g. Judge.me — free, with photo and video reviews) and add its review block here. Until then a simple review form is shown." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Real people, real results" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer" },
    { "type": "text", "id": "heading_emphasis", "label": "Heading (italic gold part)", "default": "reviews" },
    { "type": "text", "id": "text", "label": "Text when there are no reviews yet", "default": "Be the first to share how it worked for you." },
    { "type": "header", "content": "Review form (no app)" },
    { "type": "text", "id": "share_heading", "label": "Heading", "default": "Share your results" },
    { "type": "textarea", "id": "share_text", "label": "Text", "default": "Tried it? Tell us how it went — a few words, a before & after photo or a short video all help others choose." },
    { "type": "text", "id": "kind_written", "label": "Written reviews", "default": "Written reviews" },
    { "type": "text", "id": "kind_photo", "label": "Photo reviews", "default": "Photo reviews" },
    { "type": "text", "id": "kind_video", "label": "Video reviews", "default": "Video reviews" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp button", "default": "Send a photo or video on WhatsApp" },
    { "type": "text", "id": "whatsapp_message", "label": "WhatsApp message", "default": "Hi Kehsora! Here is my review of [product]:" },
    { "type": "text", "id": "rating_label", "label": "Rating label", "default": "Your rating" },
    { "type": "text", "id": "review_label", "label": "Review label", "default": "Your review" },
    { "type": "text", "id": "submit_label", "label": "Button", "default": "Submit review" },
    { "type": "text", "id": "success", "label": "Thank-you message", "default": "Thank you — your review has been sent to us." }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Product reviews" }]
}
{% endschema %}
