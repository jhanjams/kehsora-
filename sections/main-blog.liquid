<section class="page-hero">
  {% render 'mandala', class: 'hero-mandala', id: section.id, petals: 12 %}
  <div class="container">
    <div class="section-eyebrow center fade-up d0">{{ 'blogs.journal' | t }}</div>
    <h1 class="fade-up d1">{{ blog.title | escape }}</h1>
  </div>
</section>
<section class="section" style="padding-top: 1rem;">
  <div class="container">
    {%- paginate blog.articles by 9 -%}
      {%- if blog.articles.size > 0 -%}
        <div class="article-grid">
          {%- for article in blog.articles -%}
            <article class="article-card">
              <a href="{{ article.url }}" class="article-card-media">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 860px) 33vw, 100vw', alt: article.title }}
                {%- else -%}
                  {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
              <div class="article-meta">{{ article.published_at | time_tag: format: 'date' }}</div>
              <h3><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
              <p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
            </article>
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="shop-empty"><p>{{ 'blogs.empty' | t }}</p></div>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'general.pagination.label' | t }}">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">{{ 'general.pagination.previous' | t }}</a>{%- endif -%}
          <span class="current">{{ 'general.pagination.page_of' | t: current: paginate.current_page, total: paginate.pages }}</span>
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">{{ 'general.pagination.next' | t }}</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "Blog", "settings": [] }
{% endschema %}
